# Copy this file to ".env" and fill in your own values. Never commit ".env".

GROQ_API_KEY=your_groq_api_key_here
# Check https://console.groq.com/docs/deprecations if you get a 404 "model_not_found"
GROQ_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Relative paths are resolved from the project root
CHROMA_DB_PATH=data/chroma
UPLOAD_FOLDER=data/uploads
REPORT_FOLDER=data/reports

MAX_FILE_SIZE_MB=5

# Optional
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LLM_TIMEOUT_SECONDS=60
# Share of the overall score from skill coverage (0-1); the rest is semantic similarity
# SKILL_SCORE_WEIGHT=0.6

# How skills are extracted from the resume and the JD:
#   rules  = vocabulary + rule-based mining (offline, deterministic, no extra LLM calls)
#   hybrid = rules + LLM extraction verified against the document text (default;
#            finds skills written in plain sentences; falls back to rules on any error)
SKILL_EXTRACTION_MODE=hybrid

# --- LangSmith (optional): tracing + evaluation ---
# Get a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resume-jd-matcher
# Resumes contain personal data. Set to true to keep resume/JD text out of traces.
# LANGSMITH_HIDE_INPUTS=false
# LANGSMITH_HIDE_OUTPUTS=false
# Evaluation only: judge model (defaults to GROQ_MODEL). A different model avoids self-preference bias.
# JUDGE_MODEL=
